  ],
  [
   49.1,
   52,
   "Cocina **25 minutos** a fuego **medio-bajo**."
  ],
  [
   52.8,
   53.8,
   "Que hierva suave."
  ],
  [
   54.5,
   57.2,
   "A borbotones, la carne queda seca y fibrosa."
  ],
  [
   57.7,
   58.4,
   "Sácalo,"
  ],
  [
