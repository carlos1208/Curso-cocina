  ],
  [
   64.5,
   67.7,
   "Guarda **250 ml** para la salsa."
  ],
  [
   68.3,
   69.3,
   "Salsa roja."
  ],
  [
   70,
   71.1,
   "Ahora la salsa,"
  ],
  [
