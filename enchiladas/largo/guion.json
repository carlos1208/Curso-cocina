  ],
  [
   118.9,
   120.7,
   "Va a oscurecer y a espesar."
  ],
  [
   121.3,
   123.5,
   "Este paso le quita el sabor a crudo."
  ],
  [
   124.4,
   125.2,
   "Tortillas."
  ],
  [
   125.9,
   127.2,
   "Vamos con las tortillas."
  ],
  [
   127.6,
   131,
   "Calienta **120 ml** de aceite a fuego **medio**."
  ],
  [
   131.39,
