  "subtitles": [
    [0.1, 3.71, "Carne guisada colombiana, pero con técnica de restaurante."],
    [4.27, 6.42, "Tierna, profunda y brillante."],
    [6.47, 7.78, "Se deshace con la cuchara."],
    [8.7, 9.63, "Ingredientes."],
    [10.01, 14.33, "Para **4 personas** necesitas **1 kilo** de morrillo en cubos de **4 centímetros**."],
    [14.68, 19.56, "Si no estás en Colombia, pide un corte para guisar de cuello, aguja o pecho."],
    [19.61, 22.14, "En la descripción te dejo cómo se llama en tu país."],
    [22.61, 27.2, "**500 g** de papa criolla y **400 g** de tomate chonto maduro."],
    [27.64, 31.36, "**150 g** de cebolla larga y **1** cebolla roja."],
    [31.41, 33.77, "**1** pimentón rojo y **5** dientes de ajo."],
    [34.23, 38.8, "**1 cucharadita** de comino, **1** de color, **2** hojas de laurel,"],
    [38.85, 42.5, "**10 g** de sal, pimienta y **3 cucharadas** de aceite."],
    [43.22, 45.98, "**330 ml** de cerveza negra,"],
    [46.03, 49.57, "**500** de caldo de res y **20 g** de panela rallada."],
    [50.32, 51.05, "Marinado."],
    [51.07, 53.26, "Seca bien la carne con papel."],
    [53.31, 55.5, "La humedad impide que dore."],
    [55.55, 59.49, "Sazónala con la sal, la pimienta, el comino y el color."],
    [60.29, 63.74, "Déjala reposar **30 minutos** a temperatura ambiente."],
    [63.79, 66.23, "Así no enfría la olla y dora parejo."],
    [66.76, 67.35, "Sellado."],
    [67.37, 70.9, "Calienta **2 cucharadas** de aceite a **fuego alto**, hasta que humee."],
    [71.43, 74.79, "Dora la carne en **2 tandas**, unos **6 minutos** cada una."],
    [75.38, 77.48, "No la muevas los primeros **2 minutos**."],
    [77.53, 81.2, "Si llenas la olla, suelta jugo y se cocina en vez de dorarse."],
    [81.55, 82.99, "Saca la carne."],
    [83.04, 85.71, "Ese fondo café pegado es sabor."],
    [85.76, 86.64, "No lo laves."],
    [87.05, 87.6, "Hogao."],
    [88.06, 91.79, "Baja a **fuego medio** y agrega la cucharada de aceite restante."],
    [91.84, 93.55, "Suma las dos cebollas picadas."],
    [93.72, 96.59, "**5 minutos**, hasta que estén transparentes."],
    [96.64, 99.49, "Luego el ajo y el pimentón, **2 minutos** más."],
    [99.95, 101.31, "Ralla el tomate."],
    [101.36, 104.54, "La piel queda afuera y la pulpa se deshace en la salsa."],
    [105.13, 109.13, "Agrégalo con el laurel y cocina **10 minutos**, hasta que se oscurezca."],
    [109.68, 112.96, "Cuando el aceite se separa en los bordes, el hogao está listo."],
    [113.46, 113.91, "Guiso."],
    [114.58, 116.63, "Devuelve la carne con sus jugos."],
    [116.68, 119.64, "Sube a **fuego medio-alto** y vierte la cerveza negra."],
    [120.13, 123.74, "Raspa el fondo y deja reducir a la mitad, unos **3 minutos**."],
    [124.25, 126.18, "Añade el caldo y la panela."],
    [126.23, 130.62, "La panela no endulza: equilibra la acidez del tomate y la cerveza."],
    [131.13, 133.38, "Tapa y baja a **fuego bajo**."],
    [133.43, 136.06, "**1 hora y media**, con un hervor apenas visible."],
    [136.78, 140.69, "Si hierve fuerte, las fibras se tensan y la carne queda dura."],
    [141.4, 141.83, "Papas."],
    [141.85, 145.16, "Agrega la papa criolla entera y destapa."],
    [145.21, 146.87, "**30 minutos** más a **fuego bajo**."],
    [147.34, 150.39, "La salsa se reduce mientras la papa se cocina."],
    [150.44, 153.37, "Algunas se deshacen y espesan el guiso."],
    [154.0, 158.06, "Prueba y ajusta la sal al final, no antes: la salsa se concentra."],
    [158.75, 159.39, "Servicio."],
    [160.0, 163.59, "Sirve en plato hondo, con arroz blanco y tajadas de aguacate."],
    [164.2, 167.3, "Termina con cilantro picado y un hilo de salsa por encima."],
    [167.84, 170.13, "Mira cómo se abre con solo apoyar la cuchara."],
    [170.71, 171.16, "Cierre."],
    [171.66, 173.6, "Si te sirvió, suscríbete."],
    [173.65, 175.8, "Aquí cocinamos lo nuestro, con técnica."]
  ],
