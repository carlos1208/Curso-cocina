  "subtitles": [
    [0.12, 2.72, "Pollo entero al barril, abierto en mariposa."],
    [3.26, 6.29, "Piel crocante, carne jugosa y sabor a carbón."],
    [6.73, 9.34, "Y de compañía, plátano maduro con queso crema."],
    [9.9, 13.36, "Necesitas un pollo entero de **1 kilo 800 g**."],
    [13.48, 17.97, "Para el adobo costeño: **6** dientes de ajo y **20 g** de sal."],
    [18.59, 20.52, "**1 cucharada** de achiote molido,"],
    [20.74, 23.89, "**½ cucharada** de comino y **2 g** de pimienta negra."],
    [24.65, 27.31, "**80 ml** de jugo de naranja agria,"],
    [27.37, 30.87, "**120 ml** de cerveza y **2 cucharadas** de aceite."],
    [31.66, 36.22, "Para acompañar: **4** plátanos maduros y **200 g** de queso crema."],
    [36.7, 40.14, "Y para el barril, **2 kilos y medio** de carbón vegetal."],
    [40.87, 41.45, "El pollo."],
    [41.97, 43.8, "Primero, abre el pollo en mariposa."],
    [44.22, 48.74, "Con unas tijeras de cocina, corta a los dos lados del espinazo y retíralo."],
    [49.13, 52.13, "Voltea el pollo y presiona la pechuga hasta que quede plano."],
    [52.88, 53.87, "¿Por qué en mariposa?"],
    [54.65, 55.45, "Porque plano,"],
    [56.0, 60.64, "el muslo y la pechuga quedan a la misma altura del carbón y se cocinan parejo."],
    [61.37, 63.24, "Y se cocina más rápido que entero."],
    [64.19, 65.22, "Ahora, el adobo."],
    [65.74, 68.54, "En un bol, mezcla el ajo bien picado con la sal,"],
    [68.96, 71.38, "el achiote, el comino y la pimienta."],
    [71.87, 75.52, "Agrega el jugo de naranja agria, el aceite y la cerveza."],
    [75.98, 78.1, "La naranja agria aporta la acidez."],
    [78.59, 81.49, "El achiote da ese color anaranjado tan costeño."],
    [81.94, 85.71, "Baña el pollo por los dos lados y mete adobo también debajo de la piel."],
    [86.14, 89.02, "Debajo de la piel, el sabor llega directo a la carne."],
    [89.68, 92.32, "Déjalo marinar en la nevera mínimo **4 horas**."],
    [92.75, 93.94, "Lo ideal son **12**."],
    [94.49, 96.73, "Enciende el carbón en el fondo del barril."],
    [97.18, 101.99, "Espera unos **25 minutos**, hasta que las brasas estén cubiertas de ceniza gris."],
    [102.44, 104.07, "No pongas el pollo con llama viva."],
    [104.48, 107.19, "La llama quema la piel antes de que la carne se cocine."],
    [107.63, 112.16, "Tapa el barril y deja que suba a entre **180 y 200 grados**."],
    [112.52, 115.27, "Pon el pollo sobre la parrilla, con la piel hacia arriba."],
    [115.6, 119.43, "Así, la grasa de la piel se derrite y baña la carne mientras se cocina."],
    [120.18, 123.21, "Tapa y cocina entre **60 y 70 minutos**."],
    [123.69, 125.15, "No destapes a cada rato."],
    [125.5, 128.07, "Cada vez que abres, el barril pierde calor."],
    [128.8, 132.73, "Está listo cuando la parte más gruesa del muslo marca **74 grados**."],
    [133.3, 135.52, "Si no tienes termómetro, pincha el muslo."],
    [135.98, 137.83, "El jugo debe salir transparente."],
    [138.28, 141.36, "Los plátanos entran cuando al pollo le faltan **30 minutos**."],
    [141.96, 143.53, "Hazles un corte a lo largo,"],
    [143.89, 146.43, "sin quitar la cáscara, y ponlos en la parrilla."],
    [147.03, 150.45, "La cáscara los protege, y adentro se cocinan en su propio dulce."],
    [150.54, 156.55, "Después de **25 minutos**, ábrelos y rellena cada uno con **50 g** de queso crema."],
    [156.62, 160.13, "Tapa **5 minutos** más, hasta que el queso se ablande."],
    [160.59, 164.2, "Saca el pollo y déjalo reposar **10 minutos** antes de cortarlo."],
    [164.47, 168.6, "Si lo cortas de una vez, el jugo se queda en la tabla y no en la carne."],
    [168.9, 171.95, "Sírvelo con el plátano caliente y el queso derretido."],
    [172.43, 175.67, "Si te gustó, suscríbete para más recetas al carbón."],
    [176.24, 178.61, "¿Tú lo harías en mariposa o colgado entero?"],
    [179.05, 180.41, "Dímelo en los comentarios."]
  ],
